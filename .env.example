APP_NAME=mt5-ai-bot
APP_ENV=dev
APP_HOST=127.0.0.1
APP_PORT=8000
LOG_LEVEL=INFO
GEMINI_API_KEY=replace_me
GEMINI_MODEL=gemini-2.5-flash
GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/models
GEMINI_PROVIDER_PRIORITY=cli,api
GEMINI_CLI_ENABLED=true
GEMINI_API_ENABLED=true
GEMINI_CLI_TIMEOUT_SECONDS=25
GEMINI_API_TIMEOUT_SECONDS=30
MIN_CONFIDENCE=72
MIN_RISK_REWARD=1.7
MAX_SPREAD_POINTS=30
MAX_TRADES_PER_DAY=3
MAX_OPEN_POSITIONS_PER_SYMBOL=1
COOLDOWN_MINUTES=30
MAX_DAILY_LOSS=100
MODEL_SCORE_THRESHOLD=0.5
ALLOW_LIVE_TRADING=false
ENABLE_VISION=false
EMERGENCY_STOP=true
DEFAULT_SESSION_ALLOWLIST=London,NewYork,Overlap
DECISION_LOG_PATH=logs/ai_decisions.jsonl
EVENT_LOG_PATH=logs/trade_events.jsonl
